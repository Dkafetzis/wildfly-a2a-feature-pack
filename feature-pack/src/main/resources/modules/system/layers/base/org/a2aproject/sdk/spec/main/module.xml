<module xmlns="urn:jboss:module:1.9" name="org.a2aproject.sdk.spec">

    <properties>
        <property name="jboss.api" value="private"/>
    </properties>

    <resources>
        <artifact name="${org.a2aproject.sdk:a2a-java-sdk-spec}"/>
    </resources>

    <dependencies>
        <module name="java.logging"/>

        <module name="org.a2aproject.sdk.common"/>
        <module name="com.google.code.gson"/>
        <!--
            Compat03Fields decides whether to emit the v0.3 agent-card fields (url,
            preferredTransport, additionalInterfaces) by doing Class.forName on AgentCard_v0_3 from
            this module's class loader, so the v0.3 spec has to be visible from here or the fields
            are silently dropped. Optional: present only when a v0.3 layer is provisioned.
        -->
        <module name="org.a2aproject.sdk.compat03-spec" optional="true"/>
    </dependencies>
</module>

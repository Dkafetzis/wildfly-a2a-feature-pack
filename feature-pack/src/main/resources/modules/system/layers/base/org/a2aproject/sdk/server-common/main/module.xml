<module xmlns="urn:jboss:module:1.9" name="org.a2aproject.sdk.server-common">

    <properties>
        <property name="jboss.api" value="private"/>
    </properties>

    <resources>
        <artifact name="${org.a2aproject.sdk:a2a-java-sdk-server-common}"/>
    </resources>

    <dependencies>
        <module name="java.logging"/>
        <module name="jakarta.enterprise.api"/>
        <module name="jakarta.inject.api"/>

        <module name="com.google.code.gson"/>
        <module name="com.google.guava"/>
        <module name="com.google.protobuf"/>
        <module name="org.a2aproject.sdk.common"/>
        <module name="org.a2aproject.sdk.http-client"/>
        <module name="org.a2aproject.sdk.jsonrpc-common"/>
        <module name="org.a2aproject.sdk.spec"/>
        <module name="org.a2aproject.sdk.spec-grpc"/>
        <module name="io.smallrye.reactive.mutiny.zero"/>
        <!--
            BasePushNotificationSender discovers PushNotificationPayloadFormatter beans through CDI.
            The v0.3 formatter lives in compat03-server-conversion, and Weld only resolves beans from
            bean archives this module can see, so the dependency has to point this way. Optional: the
            module is present only when a v0.3 layer is provisioned.
        -->
        <module name="org.a2aproject.sdk.compat03-server-conversion" optional="true"/>
        <!-- Weld modules for proper proxy generation with package-private access -->
        <module name="org.jboss.weld.api"/>
        <module name="org.jboss.weld.core"/>
        <module name="org.jboss.weld.spi"/>
        <module name="org.slf4j"/>
    </dependencies>
</module>

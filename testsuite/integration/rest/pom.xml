<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.a2a</groupId>
        <artifactId>wildfly-a2a-testsuite-integration-parent</artifactId>
        <version>0.0.1.Alpha1-SNAPSHOT</version>
    </parent>

    <artifactId>wildfly-a2a-testsuite-integration-rest</artifactId>
    <packaging>jar</packaging>

    <name>WildFly A2A Feature-Pack - Testsuite - Integration - REST</name>

    <dependencies>
        <!-- A2A SDK client transport -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-transport-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-microprofile-config</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.reactive</groupId>
            <artifactId>mutiny-zero</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jakarta implementation for deployment -->
        <dependency>
            <groupId>org.wildfly.a2a</groupId>
            <artifactId>a2a-jakarta-rest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-provisioning</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                        <phase>test-compile</phase>
                        <configuration>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>wildfly-a2a-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <galleon-options>
                                <stability-level>${wildfly.a2a.stability}</stability-level>
                            </galleon-options>
                            <layers>
                                <layer>ee-core-profile-server</layer>
                                <layer>jaxrs-core</layer>
                                <layer>microprofile-config</layer>
                                <layer>a2a-server-http-json</layer>
                            </layers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Provision the server from a WildFly Glow deployment scan instead of the hardcoded layer
             list above. This is what exercises the org.wildfly.rule.* metadata in the A2A layer specs:
             expected-discovery pins the layer set Glow resolves, and the tests then run against the
             server provisioned from it. Activate with -Dts.glow. -->
        <profile>
            <id>glow.profile</id>
            <activation>
                <property>
                    <name>ts.glow</name>
                </property>
            </activation>
            <properties>
                <glow.phase>test-compile</glow.phase>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.wildfly.glow</groupId>
                        <artifactId>wildfly-glow-arquillian-plugin</artifactId>
                        <configuration>
                            <expected-discovery>[a2a, a2a-client-grpc, a2a-client-http-json, a2a-client-jsonrpc, a2a-server-http-json, cdi, ee-integration, jaxrs, microprofile-config]==>ee-core-profile-server,a2a-client-grpc,a2a-client-http-json,a2a-client-jsonrpc,a2a-server-http-json,jaxrs,microprofile-config</expected-discovery>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.wildfly.plugins</groupId>
                        <artifactId>wildfly-maven-plugin</artifactId>
                        <executions>
                            <!-- Disable the hardcoded-layers provisioning -->
                            <execution>
                                <id>test-provisioning</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>glow-provisioning</id>
                                <goals>
                                    <goal>provision</goal>
                                </goals>
                                <phase>test-compile</phase>
                                <configuration>
                                    <provisioning-file>${project.build.directory}/glow-scan/provisioning.xml</provisioning-file>
                                    <galleon-options>
                                        <stability-level>${wildfly.a2a.stability}</stability-level>
                                    </galleon-options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
